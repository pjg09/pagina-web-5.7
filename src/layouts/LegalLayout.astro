---
// Layout para los documentos legales (política de datos, términos, cookies).
// Solo aporta la caja tipográfica del documento — el header, footer y SEO vienen de BaseLayout.
import BaseLayout from "./BaseLayout.astro";
import { FECHA_ACTUALIZACION_LEGAL } from "../data/constantes";

interface Props {
	title: string;
	description?: string;
	titulo: string;
}

const { title, description, titulo } = Astro.props;
---

<BaseLayout title={title} description={description}>
	<section class="legal-sec">
		<div class="container">
			<header class="legal-header">
				<h1 class="display display--lg legal-header__titulo">{titulo}</h1>
				<p class="legal-header__fecha">
					Última actualización: {FECHA_ACTUALIZACION_LEGAL}
				</p>
			</header>

			<article class="legal-doc">
				<slot />
			</article>
		</div>
	</section>
</BaseLayout>

<style>
	.legal-sec {
		padding-top: calc(140px + var(--section-gap));
		padding-bottom: var(--section-gap);
		background: var(--bg-surface);
	}

	.legal-header {
		max-width: 70ch;
		margin-inline: auto;
		margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
	}

	.legal-header__titulo {
		line-height: 1.05;
		margin-bottom: 0.9rem;
	}

	.legal-header__fecha {
		color: var(--text-muted);
		font-size: 1.05rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.legal-doc {
		max-width: 70ch;
		margin-inline: auto;
		color: var(--text-dim);
		font-size: 1.12rem;
		line-height: 1.75;
	}

	/* Estilos de contenido: el slot recibe HTML plano desde cada página. */
	.legal-doc :global(h2) {
		font-family: var(--font-display);
		font-size: clamp(1.7rem, 2.6vw, 2rem);
		font-weight: 400;
		letter-spacing: 0.04em;
		color: var(--text-high);
		margin-top: 2.6rem;
		margin-bottom: 0.9rem;
		line-height: 1.2;
	}

	.legal-doc :global(h2:first-child) {
		margin-top: 0;
	}

	.legal-doc :global(h3) {
		font-size: 1.15rem;
		font-weight: 700;
		color: var(--text-secondary);
		margin-top: 1.8rem;
		margin-bottom: 0.6rem;
	}

	.legal-doc :global(p) {
		margin-bottom: 1.1rem;
		text-wrap: pretty;
	}

	.legal-doc :global(ul) {
		margin: 0 0 1.3rem 1.3rem;
		padding: 0;
	}

	.legal-doc :global(li) {
		margin-bottom: 0.45rem;
	}

	.legal-doc :global(strong) {
		color: var(--text-secondary);
		font-weight: 700;
	}

	.legal-doc :global(a) {
		color: var(--cyan);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.legal-doc :global(a:hover) {
		filter: brightness(1.25);
	}

	@media (max-width: 768px) {
		.legal-doc {
			font-size: 1.05rem;
		}
	}
</style>
