---
// Banner de consentimiento de cookies (Consent Mode v2).
// El estado por defecto (denegado) se fija en BaseLayout antes de cargar GTM.
// Este componente solo muestra el banner y, según la elección del usuario,
// actualiza el consentimiento de analytics_storage y lo persiste.
import { RUTA_COOKIES } from "../data/constantes";
---

<div
	id="cookie-consent"
	class="cookie-consent"
	role="dialog"
	aria-live="polite"
	aria-label="Aviso de cookies"
	hidden
>
	<div class="cookie-consent__inner">
		<p class="cookie-consent__texto">
			Usamos cookies propias y de terceros para analizar el uso del sitio y
			mejorar tu experiencia. Puedes aceptarlas o rechazarlas. Más información
			en nuestra <a href={RUTA_COOKIES} class="cookie-consent__link"
				>Política de Cookies</a
			>.
		</p>
		<div class="cookie-consent__acciones">
			<button
				type="button"
				id="cookie-reject"
				class="cookie-consent__btn cookie-consent__btn--ghost"
			>
				Rechazar
			</button>
			<button
				type="button"
				id="cookie-accept"
				class="cookie-consent__btn cookie-consent__btn--accept"
			>
				Aceptar
			</button>
		</div>
	</div>
</div>

<script>
	const KEY = "ocl_cookie_consent";
	const banner = document.getElementById("cookie-consent");

	function gtagUpdate(estado: "granted" | "denied") {
		// dataLayer/gtag ya existen (definidos en el head por Consent Mode).
		(window as any).dataLayer = (window as any).dataLayer || [];
		function gtag(...args: any[]) {
			(window as any).dataLayer.push(args);
		}
		gtag("consent", "update", { analytics_storage: estado });
	}

	function ocultar() {
		banner?.setAttribute("hidden", "");
	}

	function mostrar() {
		banner?.removeAttribute("hidden");
	}

	function decidir(estado: "granted" | "denied") {
		try {
			localStorage.setItem(KEY, estado);
		} catch (e) {}
		gtagUpdate(estado);
		ocultar();
	}

	document
		.getElementById("cookie-accept")
		?.addEventListener("click", () => decidir("granted"));
	document
		.getElementById("cookie-reject")
		?.addEventListener("click", () => decidir("denied"));

	// Mostrar solo si aún no hay una decisión guardada.
	let previa: string | null = null;
	try {
		previa = localStorage.getItem(KEY);
	} catch (e) {}
	if (previa !== "granted" && previa !== "denied") {
		mostrar();
	}

	// Permite reabrir el banner desde el footer para revocar/cambiar la elección.
	(window as any).openCookiePreferences = mostrar;
</script>

<style>
	.cookie-consent {
		position: fixed;
		bottom: 1rem;
		left: 1rem;
		right: 1rem;
		z-index: 1000;
		max-width: 46rem;
		margin-inline: auto;
		background: var(--bg-surface);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		box-shadow: 0 12px 40px rgba(0, 0, 0, 0.55);
	}

	.cookie-consent[hidden] {
		display: none;
	}

	.cookie-consent__inner {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		padding: 1.1rem 1.4rem;
	}

	.cookie-consent__texto {
		font-size: 0.95rem;
		line-height: 1.55;
		color: var(--text-dim);
		margin: 0;
		flex: 1;
	}

	.cookie-consent__link {
		color: var(--cyan);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.cookie-consent__link:hover {
		filter: brightness(1.25);
	}

	.cookie-consent__acciones {
		display: flex;
		gap: 0.6rem;
		flex-shrink: 0;
	}

	.cookie-consent__btn {
		padding: 0.55rem 1.25rem;
		border-radius: 6px;
		font-family: var(--font-body);
		font-size: 0.92rem;
		font-weight: 700;
		letter-spacing: 0.02em;
		cursor: pointer;
		transition: all var(--t-fast) var(--ease);
		white-space: nowrap;
	}

	.cookie-consent__btn--accept {
		background-image: linear-gradient(90deg, var(--cyan), var(--magenta));
		color: #fff;
		border: none;
	}

	.cookie-consent__btn--accept:hover {
		filter: brightness(1.2);
		transform: translateY(-1px);
	}

	.cookie-consent__btn--ghost {
		background: transparent;
		color: var(--text-dim);
		border: 1px solid var(--border);
	}

	.cookie-consent__btn--ghost:hover {
		color: var(--text-high);
		border-color: var(--text-dim);
	}

	@media (max-width: 640px) {
		.cookie-consent__inner {
			flex-direction: column;
			align-items: stretch;
			gap: 0.9rem;
			padding: 1rem 1.1rem;
		}
		.cookie-consent__acciones {
			justify-content: stretch;
		}
		.cookie-consent__btn {
			flex: 1;
		}
	}
</style>
